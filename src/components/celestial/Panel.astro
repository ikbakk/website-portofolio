---
interface Props {
  class?: string;
  scrollable?: boolean;
}
const { class: className = '', scrollable = false } = Astro.props;
---

<div class:list={['dossier', className]}>
  <div class="dossier-frame" data-panel-frame aria-hidden="true">
    {
      ['tl', 'tr', 'bl', 'br'].map((position) => (
        <svg class={`panel-corner corner-${position}`} viewBox="0 0 48 48" aria-hidden="true">
          <use href="/celestial/symbols.svg#corner" />
        </svg>
      ))
    }
  </div>
  <div
    class="dossier-content"
    tabindex={scrollable ? 0 : undefined}
    role={scrollable ? 'region' : undefined}
    aria-label={scrollable ? 'Portfolio dossier' : undefined}
  >
    <slot />
    {scrollable && <span data-scroll-end aria-hidden="true" />}
  </div>
  {
    scrollable && (
      <p class="dossier-scroll-hint" aria-hidden="true">
        Scroll to explore{' '}
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
          <path d="M10 3v13m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.25" />
        </svg>
      </p>
    )
  }
</div>
