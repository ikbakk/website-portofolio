---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['dossier', className]}>
  {
    ['tl', 'tr', 'bl', 'br'].map((position) => (
      <svg class={`panel-corner corner-${position}`} viewBox="0 0 48 48" aria-hidden="true">
        <use href="/celestial/symbols.svg#corner" />
      </svg>
    ))
  }
  <div class="dossier-content"><slot /></div>
</div>
