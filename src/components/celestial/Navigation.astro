---
import Icon from './Icon.astro';
interface Props {
  mobile?: boolean;
  home?: boolean;
  constellation?: boolean;
}
const { mobile = false, home = false, constellation = false } = Astro.props;
const items = [
  { id: 'profile', label: 'Profile' },
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<nav
  class:list={[
    constellation ? 'constellation-nav' : mobile ? 'mobile-nav' : 'main-nav',
    'flex items-center justify-center',
  ]}
  data-motion-nav
  data-constellation={constellation || undefined}
  aria-label={mobile ? 'Mobile navigation' : 'Main navigation'}
>
  {
    constellation && (
      <svg
        class="constellation-links"
        viewBox="0 0 360 170"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <>
          <path
            d="M48 40 180 85 48 130M312 40 180 85 312 130"
            fill="none"
            stroke="currentColor"
            stroke-width=".7"
          />
          <circle cx="180" cy="85" r="3" fill="currentColor" />
        </>
      </svg>
    )
  }
  {
    items.map((item) => (
      <a
        href={`${home ? '' : '/'}#${item.id}`}
        data-section-link={item.id}
        data-navigation
        aria-current={
          (home && item.id === 'profile') || (!home && item.id === 'projects') ? 'page' : undefined
        }
        class="nav-item flex flex-col items-center justify-center gap-1.5"
      >
        <>
          <Icon name={item.id} />
          <span>{item.label}</span>
          <span class="nav-active" aria-hidden="true" />
        </>
      </a>
    ))
  }
  <span class="nav-tracer" data-nav-indicator aria-hidden="true"
    ><svg viewBox="0 0 100 8" preserveAspectRatio="none"
      ><path d="M1 4 19 2.8 51 3.3 79 2 99 4 76 5.3 49 4.5 18 5.2Z" fill="currentColor"></path></svg
    ></span
  >
</nav>
