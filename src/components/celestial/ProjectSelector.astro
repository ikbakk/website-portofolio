---
import Icon from './Icon.astro';
import { featuredProjects } from '../../data/archive';
interface Props {
  variant: 'rail' | 'strip';
}
const { variant } = Astro.props;
---

<nav
  class:list={[variant === 'rail' ? 'project-rail' : 'project-strip']}
  aria-label={variant === 'rail' ? 'Choose a project' : 'Featured project archive'}
>
  {
    featuredProjects.map((project) => (
      <a
        href={`#project-${project.id}`}
        data-project-link={project.id}
        data-navigation
        aria-label={project.title}
        aria-current={project.id === 'courtside' ? 'true' : undefined}
        class="project-choice"
      >
        <span class="emblem">
          <Icon name={project.id} />
        </span>
        <span class="project-choice-copy">
          <span class="project-choice-title">{project.title}</span>
          {variant === 'strip' && (
            <span class="project-choice-description">
              {project.id === 'courtside'
                ? 'Badminton club helper'
                : project.id === 'sungkar-group'
                  ? 'Tourism website'
                  : project.id === 'beaconnect'
                    ? 'Companion app'
                    : 'Resume editor'}
            </span>
          )}
        </span>
      </a>
    ))
  }
</nav>
