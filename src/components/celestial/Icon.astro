---
interface Props {
  name: string;
  label?: string;
  class?: string;
}
const { name, label, class: className = '' } = Astro.props;
const project = ['sungkar-group', 'courtside', 'beaconnect', 'cv-builder', 'ward-monitor'].includes(
  name,
);
---

<svg
  class:list={['celestial-icon', className]}
  viewBox={project ? '0 0 64 64' : '0 0 32 32'}
  fill="none"
  stroke="currentColor"
  stroke-width={project ? 1.6 : 1.3}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
>
  {label && <title>{label}</title>}
  <use href={`/celestial/symbols.svg#${name}`}></use>
</svg>
