---
/* Decorative, viewport-wide transition layer. Content and controls remain interactive. */
---

<div class="weather-transition" data-weather-stage aria-hidden="true" hidden>
  <svg class="weather-shapes" width="0" height="0" focusable="false">
    <defs>
      <symbol id="weather-leaf-a" viewBox="0 0 48 64">
        <path d="M24 2 40 12 45 29 35 47 24 58 9 46 3 29 9 13Z" fill="currentColor"></path>
        <path d="M24 2 24 58 9 46 3 29 9 13Z" fill="#244c2c" opacity=".18"></path>
        <path
          d="m24 8 0 48m0-21 13-15M24 43 12 30m12 24-2 8"
          fill="none"
          stroke="#e8f3bf"
          stroke-width="2"
          opacity=".7"></path>
      </symbol>
      <symbol id="weather-leaf-b" viewBox="0 0 48 64">
        <path d="m38 3 4 20-9 21-21 15-7-21 9-21Z" fill="currentColor"></path>
        <path d="m38 3-26 56-7-21 9-21Z" fill="#315938" opacity=".22"></path>
        <path
          d="m36 10-23 48m12-27 12-4M18 45l-6-12"
          fill="none"
          stroke="#f3f6ce"
          stroke-width="2"
          opacity=".7"></path>
      </symbol>
      <symbol id="weather-crystal" viewBox="0 0 32 32">
        <path
          d="M16 2v28M4 9l24 14M4 23 28 9M12 5l4 4 4-4M12 27l4-4 4 4M5 14l6-1-1-6m12 18-1-6 6-1M5 18l6 1-1 6m12-18-1 6 6 1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"></path>
      </symbol>
    </defs>
  </svg>
  <div class="weather-veil" data-weather-veil></div>
  <div class="weather-particles" data-weather-particles></div>
  <div class="weather-charge" data-weather-charge></div>
  <svg
    class="weather-lightning"
    data-weather-lightning
    viewBox="0 0 1440 1000"
    preserveAspectRatio="none"
    focusable="false"
  >
    <defs>
      <path
        id="weather-bolt"
        d="m1030-30-70 122 28 18-110 101 23 30-136 101 34 31-158 146 35 21-115 158 30 12-107 180M883 218l120 25-12 37 104 47M769 339l-120-14 4 43-96 38M637 510l131 53-23 32 85 82M1040 140l84 74-24 24 84 94"
      ></path>
    </defs>
    <use href="#weather-bolt" class="bolt-halo"></use>
    <use href="#weather-bolt" class="bolt-color"></use>
    <use href="#weather-bolt" class="bolt-core"></use>
  </svg>
</div>
