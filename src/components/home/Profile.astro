---
import ThemeOrnament from './ThemeOrnament.astro';
import { site } from '../../data/site';
import UIIcon from './UIIcon.astro';
import Icon from '../celestial/Icon.astro';
---

<aside class="profile panel" aria-label="Profile">
  <ThemeOrnament placement="corner" />
  <ThemeOrnament placement="foot" />
  <a class="brand" href="/" aria-label="Home"
    ><img src="/logo-mark.svg" alt="" width="42" height="42" /></a
  >
  <div class="avatar" aria-hidden="true">IF</div>
  <h1>Muhammad<br />Iqbal Firdaus</h1>
  <p class="role">Frontend &amp; mobile engineer</p>
  <p class="location"><UIIcon name="location" size={15} /> {site.location}</p>
  <p class="intro">I build web and mobile software for everyday problems.</p>
  <nav class="profile-nav" aria-label="Portfolio sections">
    <a class="active" href="#work-start"><UIIcon name="home" /> Home</a>
    <a href="#projects"><UIIcon name="projects" /> Projects</a>
    <a href="#experience"><UIIcon name="experience" /> Experience</a>
    <a href="#about"><UIIcon name="approach" /> Approach</a>
    <a href={`mailto:${site.email}`}><UIIcon name="contact" /> Contact</a>
  </nav>
  <section id="about" class="about">
    <h2>About me</h2>
    <p>
      Builder, problem solver, and lifelong learner. I enjoy creating, improving systems, and
      exploring product ideas.
    </p>
  </section>
  <div class="socials" aria-label="Social links">
    <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub"
      ><Icon name="github" /></a
    >
    <a href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn"
      ><span class="linkedin-mark" aria-hidden="true">in</span></a
    >
    <a href={site.resume} download aria-label="Download resume"><UIIcon name="download" /></a>
  </div>
</aside>
