---
import ThemeOrnament from './ThemeOrnament.astro';
import { site } from '../../data/site';
import { techStack } from '../../data/tech-stack';
import PaperControl from './PaperControl.astro';
import UIIcon from './UIIcon.astro';
import Icon from '../celestial/Icon.astro';
interface Props {
  detail?: boolean;
}
const { detail = false } = Astro.props;
const NameTag = detail ? 'h2' : 'h1';
const AboutTag = detail ? 'h3' : 'h2';
const StackTag = detail ? 'h4' : 'h3';
---

<aside id="profile" class="profile panel" aria-label="Profile">
  <ThemeOrnament placement="corner" />
  <ThemeOrnament placement="foot" />
  <a class="brand" href="/" data-astro-reload aria-label="Home"
    ><img src="/logo-mark.svg" alt="" width="42" height="42" /></a
  >
  <div class="avatar" aria-hidden="true">IF</div>
  <NameTag class="profile-name">Muhammad<br />Iqbal Firdaus</NameTag>
  <p class="role">Frontend &amp; mobile engineer</p>
  <p class="location"><UIIcon name="location" size={15} /> {site.location}</p>
  <p class="intro">I build web and mobile software for everyday problems.</p>
  <nav class="profile-nav" aria-label="Portfolio sections">
    <PaperControl
      variant="nav"
      selected={!detail}
      aria-current={detail ? undefined : 'location'}
      href={detail ? '/#work-start' : '#work-start'}
      data-astro-reload><UIIcon name="home" /> Home</PaperControl
    >
    <PaperControl variant="nav" href={detail ? '/#projects' : '#projects'} data-astro-reload
      ><UIIcon name="projects" /> Projects</PaperControl
    >
    <PaperControl variant="nav" href={detail ? '/#experience' : '#experience'} data-astro-reload
      ><UIIcon name="experience" /> Experience</PaperControl
    >
    <PaperControl variant="nav" href="#about"><UIIcon name="approach" /> Approach</PaperControl>
    <PaperControl variant="nav" href={`mailto:${site.email}`}
      ><UIIcon name="contact" /> Contact</PaperControl
    >
  </nav>
  <section id="about" class="about">
    <AboutTag>About me</AboutTag>
    <p>
      Builder, problem solver, and lifelong learner. I enjoy creating, improving systems, and
      exploring product ideas.
    </p>
    <div class="profile-stack">
      <StackTag>Tech Stack</StackTag>
      <ul aria-label="Technologies">
        {techStack.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>
  <div class="socials" role="group" aria-label="Social links">
    <PaperControl
      variant="icon"
      href={site.github}
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"><Icon name="github" /></PaperControl
    >
    <PaperControl
      variant="icon"
      href={site.linkedin}
      target="_blank"
      rel="noreferrer"
      aria-label="LinkedIn"><span class="linkedin-mark" aria-hidden="true">in</span></PaperControl
    >
    <PaperControl variant="icon" href={site.resume} download aria-label="Download resume"
      ><UIIcon name="download" /></PaperControl
    >
  </div>
</aside>
