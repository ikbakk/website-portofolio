---
import { portfolio, selectedProjects, projectStories } from '../../data/portfolio';
import '../../styles/project-case.css';

export function getStaticPaths() {
  return selectedProjects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const story = projectStories[project.id as keyof typeof projectStories];
const previous = selectedProjects[(selectedProjects.findIndex((item) => item.id === project.id) + selectedProjects.length - 1) % selectedProjects.length];
const next = selectedProjects[(selectedProjects.findIndex((item) => item.id === project.id) + 1) % selectedProjects.length];
---
<!doctype html>
<html lang="en" data-theme="night">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={`${project.title}: ${project.description}`} />
  <title>{project.title} | {portfolio.name}</title>
</head>
<body>
  <a class="case-skip" href="#case-main">Skip to case study</a>
  <a class="case-brand" href="/" aria-label="Back to portfolio"><span aria-hidden="true">✦</span> IQBAL / ENGINEER</a>
  <main id="case-main">
    <header class="case-hero">
      {('screenshot' in project) ? <img class="case-hero-image" src={project.screenshot} alt="" /> : <div class="case-hero-art" aria-hidden="true"><span>{project.glyph}</span></div>}
      <div class="case-hero-copy frame">
        <a class="case-back" href="/#work">← All projects</a>
        <h1>{project.title}</h1>
        <p>{project.description}</p>
        <div class="case-meta"><span>{project.type}</span><span>{project.status}</span><span>{project.stack.join(' / ')}</span></div>
      </div>
    </header>
    <section class="case-overview frame" aria-label="Project overview">
      <div><h2>The context</h2><p>{story.context}</p></div>
      <div><h2>My contribution</h2><p>{story.work}</p></div>
      <div><h2>Where it stands</h2><p>{story.statusNote}</p></div>
    </section>
    <section class="case-decisions">
      <div class="frame case-decisions-inner"><div><h2>Decisions that shaped it.</h2><p>These choices guided the interface and the system behind it.</p></div>
        <ul>{story.decisions.map((decision) => <li><span aria-hidden="true">✦</span><p>{decision}</p></li>)}</ul>
      </div>
    </section>
    <section class="case-actions frame" aria-label="Project links">
      <div><p>Keep exploring</p><a href={project.href} target="_blank" rel="noreferrer">{project.linkLabel} <span aria-hidden="true">↗</span></a></div>
      <nav aria-label="Other project case studies"><a href={previous.caseHref}>← {previous.title}</a><a href={next.caseHref}>{next.title} →</a></nav>
    </section>
  </main>
  <footer class="case-footer frame"><span>{portfolio.name} / {portfolio.role}</span><a href={`mailto:${portfolio.email}`}>Get in touch ↗</a></footer>
</body>
</html>
