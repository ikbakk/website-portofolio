---
import HomeLayout from '../layouts/HomeLayout.astro';
import Profile from '../components/home/Profile.astro';
import Work from '../components/home/Work.astro';
import Widgets from '../components/home/Widgets.astro';
---

<HomeLayout>
  <div class="board">
    <div class="board-top">
      <fieldset class="theme-picker">
        <legend>Theme</legend><button type="button" data-set-weather="normal" aria-pressed="true"
          >Normal</button
        ><button type="button" data-set-weather="cryo" aria-pressed="false">Cryo</button><button
          type="button"
          data-set-weather="electro"
          aria-pressed="false">Electro</button
        >
      </fieldset>
    </div>
    <main id="content" class="home-grid" tabindex="-1"><Profile /><Work /><Widgets /></main>
    <div class="horizon" aria-hidden="true"></div>
  </div>
</HomeLayout>
