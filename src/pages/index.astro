---
import HomeLayout from '../layouts/HomeLayout.astro';
import PaperControl from '../components/home/PaperControl.astro';
import Profile from '../components/home/Profile.astro';
import Work from '../components/home/Work.astro';
import Widgets from '../components/home/Widgets.astro';
import { weatherThemeIds, weatherThemes, defaultWeatherTheme } from '../theme/weather.config';
---

<HomeLayout>
  <div class="board">
    <div class="board-top">
      <fieldset class="theme-picker">
        <legend>Element</legend>
        {
          weatherThemeIds.map((id) => {
            const theme = weatherThemes[id];
            return (
              <PaperControl
                class="element-choice"
                variant="icon"
                type="button"
                data-set-weather={id}
                data-theme-name={theme.title}
                aria-pressed={id === defaultWeatherTheme ? 'true' : 'false'}
                aria-label={`${theme.title} (${theme.icon})`}
                title={`${theme.title} · ${theme.icon}`}
              >
                <img src={`/weather/elements/${theme.icon}.svg`} width="28" height="28" alt="" />
              </PaperControl>
            );
          })
        }
      </fieldset>
    </div>
    <main id="content" class="home-grid" tabindex="-1"><Profile /><Work /><Widgets /></main>
    <div class="horizon" aria-hidden="true"></div>
  </div>
</HomeLayout>
