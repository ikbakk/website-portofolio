---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/celestial/Panel.astro';
import Icon from '../components/celestial/Icon.astro';
import Action from '../components/celestial/Action.astro';
import Navigation from '../components/celestial/Navigation.astro';
import IdentityMark from '../components/celestial/IdentityMark.astro';
import ProfileDossier from '../components/celestial/ProfileDossier.astro';
import ProjectDossier from '../components/celestial/ProjectDossier.astro';
import { archiveProjects } from '../data/archive';
import { experience } from '../data/experience';
import { site } from '../data/site';
---

<BaseLayout home>
  <div class="archive-world" data-archive-root>
    <div class="archive-grid">
      <div class="identity-column flex flex-col items-center justify-center">
        <p class="mobile-section-title" data-current-title>Profile</p>
        <IdentityMark />
        <Navigation mobile home constellation />
        <div class="identity-caption text-center">
          <div class="identity-rule" aria-hidden="true"><Icon name="spark" /></div>
          <p>Frontend &amp; mobile engineer</p>
          <span>Independent builds. Real-world problems.</span>
        </div>
        <div class="identity-actions flex flex-wrap justify-center gap-3">
          <Action href="/resume.pdf" icon="download" dark>Open resume</Action>
        </div>
        <div class="identity-info" aria-label="Portfolio information">
          <span>Mataram, Indonesia</span>
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
        </div>
      </div>
      <Panel class="main-dossier" scrollable>
        <ProfileDossier />
        <section id="projects" data-section="projects" aria-labelledby="projects-title">
          <h2 id="projects-title" class="section-title">Project archive</h2>
          <p class="section-description">
            A few things I have built, and the decisions behind them.
          </p>
          <nav class="archive-project-list flex flex-wrap gap-2" aria-label="All projects">
            {
              archiveProjects.map((project) => (
                <a href={`#project-${project.id}`} data-project-link={project.id} data-navigation>
                  <span class="selection-flare" data-selection-flare aria-hidden="true">
                    <svg viewBox="0 0 52 52" fill="currentColor">
                      <path d="m26 3 3 17 17 6-17 4-3 18-5-18L4 26l17-6ZM43 4l1.5 5.5L50 11l-5.5 1.5L43 18l-1.5-5.5L36 11l5.5-1.5Z" />
                    </svg>
                  </span>
                  <Icon name={project.id} />
                  {project.title}
                </a>
              ))
            }
          </nav>
        </section>
        <section id="experience" data-section="experience" aria-labelledby="experience-title">
          <h2 id="experience-title" class="section-title">Experience</h2>
          <p class="section-description">
            Web, mobile, and operational interfaces. Working with people, from the first requirement
            to the last detail.
          </p>
          <ol class="experience-list grid gap-5">
            {
              experience.map((item) => (
                <li>
                  <>
                    <p class="experience-period">{item.period}</p>
                    <h3>{item.title}</h3>
                    <p class="experience-organization">{item.organization}</p>
                    <p>{item.description}</p>
                  </>
                </li>
              ))
            }
          </ol>
          <a class="text-link" href="/resume.pdf" download>Download full resume (PDF)</a>
        </section>
        <section id="contact" data-section="contact" aria-labelledby="contact-title">
          <Icon name="contact" class="contact-crest" />
          <h2 id="contact-title" class="section-title">A new connection.</h2>
          <p class="section-description">
            Have a role, a project, or a problem worth working on? I would like to hear about it.
          </p>
          <dl class="contact-details grid gap-4">
            <div><dt>Based in</dt><dd>Mataram, Indonesia</dd></div><div>
              <dt>Open to</dt><dd>Remote roles, freelance work and relocation</dd>
            </div>
          </dl>
          <div class="contact-actions grid gap-3">
            <Action href="mailto:ikbakfir@gmail.com" icon="contact" dark>Email me</Action>
            <Action href="https://github.com/ikbakk" icon="github">GitHub</Action>
            <a class="text-link" href="https://linkedin.com/in/ikbakk">Find me on LinkedIn</a>
            <a class="text-link" href="/resume.pdf" download>Download resume (PDF)</a>
          </div>
        </section>
        <div class="dossier-projects" data-project-area>
          <div class="ornament-rule" aria-hidden="true"><Icon name="spark" /></div>
          <div class="project-section-topline flex items-center justify-between">
            <span>Selected project</span>
          </div>
          {archiveProjects.map((project) => <ProjectDossier project={project} />)}
        </div>
      </Panel>
    </div>
  </div>
</BaseLayout>
