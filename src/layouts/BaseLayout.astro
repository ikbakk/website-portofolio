---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Icon from '../components/celestial/Icon.astro';
import Opening from '../components/celestial/Opening.astro';
import Navigation from '../components/celestial/Navigation.astro';
import bodyFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { archiveProjects } from '../data/archive';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  gameScreen?: boolean;
  caseStudy?: boolean;
}
const {
  title = 'Muhammad Iqbal Firdaus | Frontend & mobile engineer',
  description = 'Web, mobile and practical tools by Muhammad Iqbal Firdaus, a frontend and mobile engineer based in Mataram, Indonesia.',
  home = false,
  gameScreen = false,
  caseStudy = false,
} = Astro.props;
const origin = site.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammad Iqbal Firdaus',
  jobTitle: 'Frontend and mobile engineer',
  url: origin,
  sameAs: ['https://github.com/ikbakk', 'https://linkedin.com/in/ikbakk'],
};
---

<!doctype html>
<html lang="en" data-theme="celestial">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <script
      is:inline
      data-astro-rerun
      data-home={String(home)}
      data-projects={JSON.stringify(archiveProjects.map((p) => p.id))}
    >
      (() => {
        const config = document.currentScript;
        if (config instanceof HTMLScriptElement && config.dataset.home === 'true') {
          const projectIds = JSON.parse(config.dataset.projects || '[]');
          const hash = location.hash.slice(1);
          const project =
            hash.startsWith('project-') && projectIds.includes(hash.slice(8))
              ? hash.slice(8)
              : 'courtside';
          const section =
            hash.startsWith('project-') && projectIds.includes(hash.slice(8))
              ? 'projects'
              : ['profile', 'projects', 'experience', 'contact'].includes(hash)
                ? hash
                : 'profile';
          const initial = document.createElement('style');
          initial.textContent = `.archive-world:not([data-archive-ready]) [data-section]:not([data-section="${section}"]), .archive-world:not([data-archive-ready]) [data-project-dossier]:not([data-project-dossier="${project}"]) { display:none; } .archive-world:not([data-archive-ready]) [data-section], .archive-world:not([data-archive-ready]) .project-dossier { margin-bottom:0; } .archive-world:not([data-archive-ready]) .identity-column { align-self:auto; } ${section !== 'projects' ? '.archive-world:not([data-archive-ready]) [data-project-area] { display:none; }' : ''}`;
          document.head.append(initial);
          setTimeout(() => {
            if (!document.querySelector('[data-archive-ready]')) initial.remove();
          }, 1800);
          let seen = Boolean(Reflect.get(window, '__celestialIntroSeen'));
          try {
            seen ||= sessionStorage.getItem('celestial-intro-seen') === '1';
          } catch {}
          if (
            !seen &&
            (!location.hash || location.hash === '#profile') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            Reflect.set(window, '__celestialIntroSeen', true);
            try {
              sessionStorage.setItem('celestial-intro-seen', '1');
            } catch {}
            const html = document.documentElement;
            html.dataset.opening = 'pending';
            html.dataset.openingDeadline = String(performance.now() + 1600);
            setTimeout(() => {
              delete html.dataset.opening;
              delete html.dataset.openingDeadline;
            }, 1600);
          }
        }
      })();
    </script>
    <title>{title}</title><meta name="description" content={description} /><meta
      name="theme-color"
      content="#14263d"
    />
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={`${origin}/og.jpg`}
    />
    <meta property="og:image:width" content="1200" /><meta
      property="og:image:height"
      content="630"
    /><meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" /><ClientRouter />
  </head>
  <body
    class:list={[
      'min-h-svh bg-midnight font-body text-ivory antialiased',
      { 'game-screen': home || gameScreen, 'case-study-screen': caseStudy },
    ]}
  >
    <a class="skip-link" href="#content">Skip to content</a>
    <picture class="environment" aria-hidden="true">
      <source
        media="(max-width:700px)"
        srcset="/celestial/celestial-city-mobile.webp"
        width="780"
        height="1190"
      />
      <img
        src="/celestial/celestial-city.webp"
        width="1586"
        height="992"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="environment-scrim" aria-hidden="true"></div>
    {home && <Opening />}
    <header class="site-header flex items-center justify-between">
      <a href="/#profile" class="brand flex items-center gap-3" aria-label="Iqbal portfolio home">
        <Icon name="profile" class="brand-icon" />
        <span
          ><span class="brand-title" data-current-title>{home ? 'Profile' : 'Archive'}</span><span
            class="brand-subtitle">Iqbal / Portfolio</span
          ></span
        >
      </a>
      <Navigation home={home} />
      <div class="header-ornament" aria-hidden="true"><span></span><Icon name="profile" /></div>
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    {!home && !gameScreen && <Navigation mobile home={home} />}
    <footer class="site-footer text-center">
      {
        home ? (
          <>
            <>
              <span class="screen-location">
                <Icon name="pin" />
                Mataram, Indonesia
              </span>
              <nav aria-label="Social links">
                <>
                  <a href={site.github}>GitHub</a>
                  <a href={site.linkedin}>LinkedIn</a>
                </>
              </nav>
            </>
          </>
        ) : (
          <>
            <>
              <span>Made with care in Mataram.</span>
              <span>Astro &amp; Tailwind CSS</span>
              <a href="https://github.com/ikbakk/website-portofolio">Source code</a>
            </>
          </>
        )
      }
    </footer>
    <script>
      import '../scripts/celestial/controller';
    </script>
  </body>
</html>
