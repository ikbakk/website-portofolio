---
import '../styles/home.css';
import '../styles/paper-controls.css';
import '../styles/widgets.css';
import '../styles/work-structure.css';
import '../styles/work-sections.css';
import '../styles/weather-transition.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import WeatherTransition from '../components/home/WeatherTransition.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title = 'Muhammad Iqbal Firdaus | Frontend & mobile engineer',
  description = 'Web, mobile and practical tools by Muhammad Iqbal Firdaus, a frontend and mobile engineer based in Mataram, Indonesia.',
  canonicalPath = '/',
  structuredData,
} = Astro.props;
const canonical = new URL(canonicalPath, site.url).href;
---

<!doctype html>
<html lang="en" data-weather="normal">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const theme = sessionStorage.getItem('portfolio-weather');
        if (['normal', 'cryo', 'electro'].includes(theme))
          document.documentElement.dataset.weather = theme;
      } catch {
        /* optional session preference */
      }
    </script>
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#f7f8f2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={site.url + '/og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: site.name,
        jobTitle: 'Frontend and mobile engineer',
        url: site.url,
        sameAs: [site.github, site.linkedin],
      })}
    />
    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <WeatherTransition />
    <script>
      import { mountWeatherControls } from '../scripts/weather/controls';
      mountWeatherControls();
      const navigation = document.querySelectorAll<HTMLAnchorElement>('.profile-nav a[href^="#"]');
      navigation.forEach((link) =>
        link.addEventListener('click', () => {
          navigation.forEach((item) => {
            item.dataset.selected = String(item === link);
            if (item === link) item.setAttribute('aria-current', 'location');
            else item.removeAttribute('aria-current');
          });
        }),
      );
    </script>
  </body>
</html>
