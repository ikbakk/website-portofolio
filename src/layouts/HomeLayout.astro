---
import '../styles/home.css';
import '../styles/paper-controls.css';
import { site } from '../data/site';
---

<!doctype html>
<html lang="en" data-weather="normal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Muhammad Iqbal Firdaus | Frontend &amp; mobile engineer</title>
    <meta
      name="description"
      content="Web, mobile and practical tools by Muhammad Iqbal Firdaus, a frontend and mobile engineer based in Mataram, Indonesia."
    />
    <link rel="canonical" href={site.url + '/'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Muhammad Iqbal Firdaus | Frontend & mobile engineer" />
    <meta
      property="og:description"
      content="Web, mobile and practical tools by Muhammad Iqbal Firdaus."
    />
    <meta property="og:url" content={site.url + '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={site.url + '/og.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-weather]');
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const theme = button.dataset.setWeather;
          if (!theme) return;
          document.documentElement.dataset.weather = theme;
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        }),
      );
      const navigation = document.querySelectorAll<HTMLAnchorElement>('.profile-nav a[href^="#"]');
      navigation.forEach((link) =>
        link.addEventListener('click', () => {
          navigation.forEach((item) => {
            item.dataset.selected = String(item === link);
            if (item === link) item.setAttribute('aria-current', 'location');
            else item.removeAttribute('aria-current');
          });
        }),
      );
    </script>
  </body>
</html>
