---
import BaseLayout from './BaseLayout.astro';
import Panel from '../components/celestial/Panel.astro';
import Icon from '../components/celestial/Icon.astro';
import Action from '../components/celestial/Action.astro';
import Navigation from '../components/celestial/Navigation.astro';
import IdentityMark from '../components/celestial/IdentityMark.astro';
import type { ArchiveProject } from '../data/archive';
import { archiveProjects, stageLabels } from '../data/archive';
interface Props {
  project: ArchiveProject;
}
const { project } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: `https://ikbak.vercel.app${project.caseHref}`,
  author: { '@type': 'Person', name: 'Muhammad Iqbal Firdaus' },
};
---

<BaseLayout
  title={`${project.title} | Muhammad Iqbal Firdaus`}
  description={project.source.lede}
  gameScreen
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="archive-world case-world" data-archive-ready="true">
    <div class="archive-grid case-grid">
      <div class="identity-column flex flex-col items-center justify-center">
        <p class="mobile-section-title">Projects</p>
        <IdentityMark />
        <Navigation mobile home={false} constellation />
        <div class="identity-caption text-center">
          <div class="identity-rule" aria-hidden="true"><Icon name="spark" /></div>
          <p>Project archive</p>
          <span>{project.title}</span>
        </div>
        <div class="case-identity-info" aria-label="Portfolio information">
          <span>Made with care in Mataram.</span>
          <span>Astro &amp; Tailwind CSS</span>
          <a href="https://github.com/ikbakk/website-portofolio">Source code</a>
        </div>
      </div>
      <Panel class="main-dossier case-dossier" scrollable>
        <a class="case-back-link" href={`/#project-${project.id}`}>
          <Icon name="arrow" />
          <span>Back to archive</span>
        </a>
        <article class="case-article">
          <header class="case-heading">
            <div class="case-overline">
              <span data-project-stage>{project.kind} / {stageLabels[project.stage]}</span>
              <span>Project dossier</span>
            </div>
            <h1>{project.title}</h1>
            <p class="case-summary">{project.summary}</p>
            <dl class="case-facts">
              <div><dt>My role</dt><dd>{project.source.role}</dd></div>
              <div><dt>Built with</dt><dd>{project.stack.join(', ')}</dd></div>
            </dl>
          </header>
          {
            project.image ? (
              <figure class="case-capture">
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width={project.image.width}
                  height={project.image.height}
                  loading="eager"
                />
                <figcaption>
                  {project.image.caption}
                  {project.stage === 'prototype' ? ' Prototype with synthetic data.' : ''}
                </figcaption>
              </figure>
            ) : (
              <figure class="case-illustration">
                {project.id === 'courtside' ? (
                  <img
                    src="/celestial/court.svg"
                    alt="Illustration of a badminton court"
                    width="320"
                    height="240"
                  />
                ) : (
                  <span class="emblem case-emblem">
                    <Icon name={project.id} />
                  </span>
                )}
                <figcaption>
                  Original project illustration. Not an application screenshot.
                </figcaption>
              </figure>
            )
          }
          <div class="case-prose"><slot /></div>
          <aside class="case-disclosure">
            <Icon name="projects" /><p>{project.source.disclosure}</p>
          </aside>
          <Action href={project.source.link.href} icon="projects" dark
            >{project.source.link.label}</Action
          >
        </article>
        <nav class="other-projects" aria-label="Other case studies">
          <h2>Continue exploring</h2>
          <div class="other-project-list">
            {
              archiveProjects
                .filter((p) => p.id !== project.id)
                .map((p) => (
                  <a href={p.caseHref}>
                    <Icon name={p.id} />
                    <span>{p.title}</span>
                    <Icon name="arrow" />
                  </a>
                ))
            }
          </div>
        </nav>
      </Panel>
    </div>
  </div>
</BaseLayout>
