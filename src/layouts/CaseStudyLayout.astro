---
import PortfolioFrame from './PortfolioFrame.astro';
import ThemeOrnament from '../components/home/ThemeOrnament.astro';
import PaperControl from '../components/home/PaperControl.astro';
import Icon from '../components/celestial/Icon.astro';
import type { ArchiveProject } from '../data/archive';
import { archiveProjects, stageLabels } from '../data/archive';
import { site } from '../data/site';
interface Props {
  project: ArchiveProject;
}
const { project } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: site.url + project.caseHref,
  author: { '@type': 'Person', name: site.name },
};
---

<PortfolioFrame
  detail
  title={`${project.title} | ${site.name}`}
  description={project.source.lede}
  canonicalPath={project.caseHref}
  structuredData={schema}
>
  <section
    class="work panel project-detail"
    data-detail-work
    aria-label={`${project.title} case study`}
  >
    <ThemeOrnament placement="corner" /><ThemeOrnament placement="foot" />
    <div class="detail-toolbar">
      <PaperControl class="case-back-link" data-astro-reload href={`/#project-${project.id}`}>
        <span aria-hidden="true">←</span> Back to projects
      </PaperControl>
      <span class="detail-path">/ project</span>
    </div>
    <div class="work-body">
      <div class="work-scroll" tabindex="0" role="region" aria-label="Project case study">
        <article class="case-article">
          <header class="case-heading">
            <span class="badge" data-project-stage
              >{project.kind} / {stageLabels[project.stage]}</span
            >
            <h1>{project.title}</h1>
            <p class="case-summary">{project.summary}</p>
          </header>
          {
            project.image ? (
              <figure class="case-capture">
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width={project.image.width}
                  height={project.image.height}
                  fetchpriority="high"
                  decoding="async"
                />
                <figcaption>
                  {project.image.caption}
                  {project.stage === 'prototype' ? ' Prototype with synthetic data.' : ''}
                </figcaption>
              </figure>
            ) : (
              <p class="case-image-note">Application screenshot not yet available.</p>
            )
          }
          <div class="case-prose"><slot /></div>
          <aside class="case-disclosure">
            <Icon name="projects" /><p>{project.source.disclosure}</p>
          </aside>
          <PaperControl variant="primary" href={project.source.link.href}
            >{project.source.link.label}</PaperControl
          >
        </article>
      </div>
    </div>
  </section>
  <aside slot="sidebar" class="detail-sidebar panel" aria-label="Project information">
    <ThemeOrnament placement="corner" /><ThemeOrnament placement="foot" />
    <h2>Project details</h2>
    <dl class="detail-facts">
      <div><dt>My role</dt><dd>{project.source.role}</dd></div>
      <div><dt>Status</dt><dd>{stageLabels[project.stage]}</dd></div>
      <div><dt>Built with</dt><dd>{project.stack.join(', ')}</dd></div>
    </dl>
    <nav class="detail-other" aria-label="Other case studies">
      <h2>Continue exploring</h2>
      {
        archiveProjects
          .filter((p) => p.id !== project.id)
          .map((p) => (
            <PaperControl class="detail-next" href={p.caseHref}>
              {p.title}
              <span aria-hidden="true">↗</span>
            </PaperControl>
          ))
      }
    </nav>
  </aside>
</PortfolioFrame>
